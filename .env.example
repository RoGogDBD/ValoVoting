# Заполняется автоматически мастером настройки при первом запуске.
# Вручную можно задать только если нужно изменить настройки.

TWITCH_BROADCASTER_ID=your_broadcaster_id_here
TWITCH_ACCESS_TOKEN=your_oauth_token_here
TWITCH_CHANNEL=your_twitch_login_here

# Опционально (есть значения по умолчанию)
CHAT_COMMAND=!mapvote
DEFAULT_POLL_DURATION=60
PORT=8080

# Только для разработки — переопределяет Client ID, встроенный в бинарь
# TWITCH_CLIENT_ID=your_dev_client_id
